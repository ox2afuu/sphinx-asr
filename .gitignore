# override global gitignore — this repo tracks its CLAUDE.md
!CLAUDE.md

features/
experiments/
*.log
bin/

# python stuff
__pycache__
.venv/
venv

# vendor stuff
vendor/cmu_toolkit/lib/
*.o
*.a

# Ignore all corpus files, but keep directory structure and yaml files.
# The following is what is kept:
# corpus/
#     corpus_name/
#         dict/  (contents ignored but folder kept)
#         lm/    (contents ignored but folder kept)
#     corpus.yml
#     experiment.yml.template
corpus/*/**
!corpus/*/
# keep yaml files
!corpus/*/corpus.yml
!corpus/*/experiment.yml.template

# keep the scaffold dirs
!corpus/*/lm/
!corpus/*/dict/
!corpus/*/lm/.gitkeep
!corpus/*/dict/.gitkeep

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
